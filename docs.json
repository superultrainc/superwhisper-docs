              {
                "group": "Other Guides",
                "pages": [
                  "common-issues/realtime",
                  "common-issues/context",
                  "common-issues/ios-26-keyboard-changes",
                  "common-issues/diagnostics"
                ]
              }
            ]
          },
          {
            "group": "Enterprise",
            "pages": [
              "enterprise/getting-started",
              "enterprise/activate",
              {
                "group": "Authentication & Deployment",
                "pages": [
                  "enterprise/saml-sso",
                  "enterprise/scim",
                  "enterprise/mdm-deployment",
                  "enterprise/member-management"
