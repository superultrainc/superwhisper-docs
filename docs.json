                "group": "Custom",
                "pages": [
                  "modes/custom",
                  "modes/customizing-modes",
                  "modes/speaker-separated-meetings"
                ]
              },
              "modes/switching-modes"
            ]
          },
          {
            "group": "Features",
            "pages": [
              {
                "group": "The Interface",
                "pages": [
                  "get-started/interface-menu-bar",
                  "get-started/interface-rec-window",
